# Installed as /usr/share/proximos/brand.env, read by set-hostname.sh and
# proximos-tls-cert.sh. Mirrors brand.toml; proximos-brand's tests fail if the two differ.
BRAND_ID='proximos'
BRAND_PRODUCT='ProXimos'
BRAND_HUB='ProXimos Hub'
BRAND_HOSTNAME_PREFIX='proximos-'
BRAND_CERT_ORGANISATION='ProXimos'
BRAND_SUPPORT_URL='https://www.proximos.cz'
