/dev/root            /                    auto       defaults              1  1
proc                 /proc                proc       defaults              0  0
devpts               /dev/pts             devpts     mode=0620,ptmxmode=0666,gid=5      0  0
tmpfs                /run                 tmpfs      mode=0755,nodev,nosuid,strictatime 0  0
tmpfs                /var/volatile        tmpfs      defaults              0  0

/dev/vda1       /boot   vfat    defaults,noexec,nosuid,nodev,nofail,x-systemd.device-timeout=15s    0   0

/dev/vda4       /data   ext4    defaults,noexec,nosuid,nodev,nofail,x-systemd.device-timeout=15s,x-systemd.growfs,x-systemd.after=systemd-repart.service   0   2

/data/log/journal  /var/log/journal  none  bind,nofail,x-systemd.requires=proximos-data-dirs.service   0   0
